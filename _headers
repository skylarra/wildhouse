# Cloudflare Pages cache strategy (launch)
#
# Model:
# - HTML + JSON/data always revalidate (deployments visible immediately).
# - JS/CSS always revalidate; ETag keeps repeat visits cheap (304).
#   (No bundler — ES module relative imports cannot safely share a query hash.)
# - /assets/* may be cached long-term ONLY because references append ?v=<hash>
#   (see js/asset-versions.js + scripts/update-asset-versions.py).
#
# Cloudflare dashboard: set Browser Cache TTL to "Respect Existing Headers"
# (or equivalent). Do not override these with a long zone-level TTL.

# HTML entry points
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/admin/
  Cache-Control: public, max-age=0, must-revalidate

/admin/*
  Cache-Control: public, max-age=0, must-revalidate

# Editable content + local catalog fallback — always fresh
/content/*
  Cache-Control: public, max-age=0, must-revalidate

/data/*
  Cache-Control: public, max-age=0, must-revalidate

# Application code — revalidate every navigation; 304 when unchanged
/js/*
  Cache-Control: public, max-age=0, must-revalidate

/css/*
  Cache-Control: public, max-age=0, must-revalidate

/styles.css
  Cache-Control: public, max-age=0, must-revalidate

# Fingerprinted media (URLs include ?v=<content-hash>)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
